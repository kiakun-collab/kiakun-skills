# Agent setup template. Copy to local .gateway.env or ~/.gateway.env, then fill real keys outside
# the skill repository and version control.

# Required for standard/VIP aifast.site image generation and editing.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://aifast.site/v1

# Optional. Required only for AtlasCloud edit fallback or forced --profile atlas.
ATLASCLOUD_API_KEY=
ATLASCLOUD_BASE_URL=https://api.atlascloud.ai/api/v1/model

# Cost-aware routing. "auto" uses standard unless multiple references, --quality, or 2K/4K requires
# VIP.
GPT_IMAGE_PROFILE=auto
GPT_IMAGE_STANDARD_SIZE=1024x1024
GPT_IMAGE_VIP_SIZE=2048x2048
GPT_IMAGE_VIP_QUALITY=high
GPT_IMAGE_ATLAS_FALLBACK=true
GPT_IMAGE_ATLAS_SIZE=2048x2048
GPT_IMAGE_ATLAS_QUALITY=high
# Default image count. The scripts accept 1 through 10.
GPT_IMAGE_N=1

# 0 means no local client timeout for aifast standard/VIP image requests. Keep this for long
# high-resolution jobs unless the caller intentionally needs its own abort limit.
OPENAI_IMAGE_TIMEOUT_MS=0
OPENAI_IMAGE_MAX_RETRIES=2
ATLASCLOUD_POLL_INTERVAL_MS=2000
ATLASCLOUD_POLL_TIMEOUT_MS=300000
