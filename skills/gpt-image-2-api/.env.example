# Required. Keep the real value outside the skill and version control.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://aifast.site/v1

# Cost-aware routing. "auto" uses standard unless VIP is required.
GPT_IMAGE_PROFILE=auto
GPT_IMAGE_STANDARD_SIZE=1024x1024
GPT_IMAGE_VIP_SIZE=2048x2048
GPT_IMAGE_VIP_QUALITY=high
# Default image count. The scripts accept 1 through 10.
GPT_IMAGE_N=1

OPENAI_IMAGE_TIMEOUT_MS=300000
OPENAI_IMAGE_MAX_RETRIES=2
